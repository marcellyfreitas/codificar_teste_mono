# URL da API Laravel. O proxy do Nuxt intercepta /api/v1/** e repassa para cá.
# Isso evita expor a origem no bundle e elimina preflight CORS no caminho crítico.
#
# Nota: com APP_DEBUG=true no backend, respostas 403 e 404 incluem stack trace
# no JSON. O adapter lê apenas `message` de qualquer forma, então o trace não
# vaza para a UI — mas prefira APP_DEBUG=false em qualquer ambiente compartilhado.
NUXT_API_ORIGIN=http://localhost:8000
